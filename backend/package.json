{
  "name": "noolagam-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy -c wrangler.staging.jsonc",
    "deploy:prod": "wrangler deploy -c wrangler.production.jsonc",
    "tail:staging": "wrangler tail -c wrangler.staging.jsonc",
    "tail:prod": "wrangler tail -c wrangler.production.jsonc",
    "db:schema:staging": "wrangler d1 execute DB --remote --file=./schema.sql -y -c wrangler.staging.jsonc",
    "db:schema:prod": "wrangler d1 execute DB --remote --file=./schema.sql -y -c wrangler.production.jsonc",
    "db:schema:local": "wrangler d1 execute DB --local --file=./schema.sql -y",
    "cli": "tsx cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "hono": "^4.6.0",
    "linkedom": "^0.18.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
