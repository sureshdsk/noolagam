{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // LOCAL DEV ONLY — drives `wrangler dev`. Never deployed.
  //
  // D1 is miniflare's local SQLite (database_id is required but unused locally).
  // S3_* and secrets come from .dev.vars (MinIO on :9100) — see .env.example.
  // Deployed environments live in wrangler.staging.jsonc / wrangler.production.jsonc.
  "name": "noolagam-api-local",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noolagam-catalog-local",
      "database_id": "local-dev"
    }
  ],
  "vars": {
    "AUTH_ENFORCE": "false",
    "S3_REGION": "auto"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
