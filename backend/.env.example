# Admin API key for mutation endpoints in dev (header: X-Admin-Key)
ADMIN_API_KEY=

# Set true to require JWT on content routes (any OIDC provider via JWKS, e.g. Clerk)
AUTH_ENFORCE=false
CLERK_JWKS_URL=
CLERK_ISSUER=

# Optional LLM — OpenAI-compatible HTTP (works with OpenAI, Gemini compat endpoint, Groq, Ollama).
# Unset => LLM pipeline stages are skipped, publishing still succeeds.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# S3-compatible storage (R2 / S3 / MinIO / B2). Unset => filesystem adapter (local dev only).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
